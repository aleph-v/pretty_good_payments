    // ==================== MULTI-BLOB TESTS ====================

    // Test challenge with data spanning multiple blobs (both first and second blob access)
    function test_MultipleBlobsNullifierChallenge() public {
        bytes32 anchor = keccak256("anchor");

        // Create block large enough to span multiple blobs
        // Each blob holds 4096 elements, each tx needs 15
        // 300 transactions = 4500 elements = 2 blobs
        Spine.BlockData memory block1 = Spine.BlockData({
            anchor: anchor,
            timestamp: block.timestamp,
            numTransactions: 300,
            numDeposits: 0,
            blockNr: 0,
            blockIndex: Spine.TimestampAndIndex(0, 0),
            sequencer: address(this),
            blobhashes: new bytes32[](2)
        });

        (block1,) = harness.setupBlocks(block1, 111);

        bytes32[] memory blobhashes = block1.blobhashes;
        vm.blobhashes(blobhashes);

        uint256[] memory indices = new uint256[](2);
        indices[0] = 0;
        indices[1] = 1;

        block1 = harness.addBlockTest(block1, indices);
        Spine.BlockData memory block2 = harness.addBlockTest(block1, indices);

        // Test 1: Access nullifier in first blob (tx 0, position 9)
        bytes32 nullifier = harness.access(blobhashes[0], 9);

        NullifierChallenge.NullifierLoader memory loader1 =
            NullifierChallenge.NullifierLoader({data: block1, txNr: 0, whichNullifier: 0, commitment: "", proof: ""});
        NullifierChallenge.NullifierLoader memory loader2 =
            NullifierChallenge.NullifierLoader({data: block2, txNr: 0, whichNullifier: 0, commitment: "", proof: ""});

        harness.challengeNullifier(nullifier, loader1, loader2, block1);

        // Test 2: Access nullifier in second blob (tx 280)
        // tx 280's nullifier 0: 280*15 + 9 = 4209, blob 1 position 4209 % 4096 = 113
        // Need to add blocks again after rollback
        block1.blockNr = 0;
        block1 = harness.addBlockTest(block1, indices);
        block2 = harness.addBlockTest(block1, indices);

        uint256 expectedPos = harness.getNullifierMemoryAddress(280, 0, 0);
        uint256 blobIndex = expectedPos / 4096;
        uint256 posInBlob = expectedPos % 4096;
        assertEq(blobIndex, 1, "Should be in second blob");

        nullifier = harness.access(blobhashes[blobIndex], posInBlob);

        loader1.data = block1;
        loader1.txNr = 280;
        loader2.data = block2;
        loader2.txNr = 280;

        harness.challengeNullifier(nullifier, loader1, loader2, block1);
    }

    // ==================== FUZZ TESTS ====================

    // Helper to calculate deposit memory size
    function _depositMemorySize(uint256 numDeposits) internal pure returns (uint256) {
        if (numDeposits == 0) return 0;
        return numDeposits % 3 == 0 ? (numDeposits / 3) * 4 : (numDeposits / 3 + 1) * 4;
    }

    // Helper to calculate number of blobs needed
    function _numBlobsNeeded(uint256 numDeposits, uint256 numTransactions) internal pure returns (uint256) {
        uint256 totalElements = _depositMemorySize(numDeposits) + numTransactions * 15;
        return (totalElements + 4095) / 4096; // Ceiling division
    }

    // Helper to create and add an intermediate block with unique random data
    // Separated into its own function to reduce stack pressure in the main fuzz test
    function _addIntermediateBlock(uint256 seed) internal returns (Spine.BlockData memory) {
        Spine.BlockData memory intermediateBlock = Spine.BlockData({
            anchor: keccak256(abi.encodePacked("intermediate", seed)),
            timestamp: block.timestamp,
            numTransactions: 100,
            numDeposits: 250,
            blockNr: 0,
            blockIndex: Spine.TimestampAndIndex(0, 0),
            sequencer: address(this),
            blobhashes: new bytes32[](1)
        });
        (intermediateBlock,) = harness.setupBlocks(intermediateBlock, seed);
        vm.blobhashes(intermediateBlock.blobhashes);

        uint256[] memory indices = new uint256[](1);
        indices[0] = 0;

        return harness.addBlockTest(intermediateBlock, indices);
    }

    /// @notice Fuzz test for valid nullifier challenges with random block configurations
    /// @param seed Random seed for data generation
    /// @param numDeposits Number of deposits (bounded to reasonable range)
    /// @param numTransactions Number of transactions (bounded to ensure <= 6 blobs)
    /// @param txNrFirst Transaction number to challenge in first block
    /// @param whichNullifier1 Which nullifier (0 or 1) for first loader
    /// @param whichNullifier2 Which nullifier (0 or 1) for second loader
    /// @param numIntermediateBlocks Number of blocks between the two challenged blocks
    function testFuzz_ValidNullifierChallenge(
        uint256 seed,
        uint16 numDeposits,
        uint16 numTransactions,
        uint16 txNrFirst,
        uint8 whichNullifier1,
        uint8 whichNullifier2,
        uint8 numIntermediateBlocks
    ) public {
        vm.pauseGasMetering();
        // Target up to 6 blobs = 24576 elements max (keeps gas/memory manageable)
        // Each tx = 15 elements, so max ~1600 tx with no deposits
        // Cap deposits to leave room for transactions
        uint256 boundedDeposits = bound(numDeposits, 0, 2000); // ~2668 slots max

        // Calculate remaining capacity for transactions
        uint256 depositSlots = _depositMemorySize(boundedDeposits);
        uint256 maxElements = 6 * 4096; // 6 blobs max for gas efficiency
        uint256 remainingSlots = depositSlots >= maxElements ? 15 : maxElements - depositSlots;
        uint256 maxTx = remainingSlots / 15;
        if (maxTx == 0) maxTx = 1;

        uint256 boundedTransactions = bound(numTransactions, 1, maxTx);
        uint256 boundedTxNr = bound(txNrFirst, 0, boundedTransactions - 1);
        uint256 boundedWhich1 = bound(whichNullifier1, 0, 1);
        uint256 boundedWhich2 = bound(whichNullifier2, 0, 1);
        uint256 boundedIntermediateBlocks = bound(numIntermediateBlocks, 0, 10);

        bytes32 anchor = keccak256(abi.encodePacked("anchor", seed));

        // Create initial block - blobhashes will be set by setupBlocks
        Spine.BlockData memory block1 = Spine.BlockData({
            anchor: anchor,
            timestamp: block.timestamp,
            numTransactions: boundedTransactions,
            numDeposits: boundedDeposits,
            blockNr: 0,
            blockIndex: Spine.TimestampAndIndex(0, 0),
            sequencer: address(this),
            blobhashes: new bytes32[](1) // Placeholder, will be replaced
        });

        // For valid challenge, we need the nullifier VALUES to match
        (block1,) = harness.setupBlocks(block1, seed);
        bytes32[] memory blobhashes = block1.blobhashes;

        // Use actual blob count from store() result
        uint256 numBlobs = blobhashes.length;
        vm.blobhashes(blobhashes);

        // Create blob indices array using actual blob count
        uint256[] memory indices = new uint256[](numBlobs);
        for (uint256 i = 0; i < numBlobs; i++) {
            indices[i] = i;
        }

        // Add first block
        block1 = harness.addBlockTest(block1, indices);

        // Track the block that comes right before block2 (for rollback target)
        Spine.BlockData memory rollbackTarget = block1;

        // Add intermediate blocks with unique random data
        for (uint256 i = 0; i < boundedIntermediateBlocks; i++) {
            vm.warp(block.timestamp + 1);
            // Each intermediate block gets unique data via different seed
            rollbackTarget = _addIntermediateBlock(seed);
        }

        // Add time gap before final block
        vm.warp(block.timestamp + 1);

        // Restore block1's blobhashes for the final block (to create duplicate nullifiers)
        vm.blobhashes(blobhashes);

        // Add second block with same blob data as block1 (creates duplicate nullifiers)
        Spine.BlockData memory block2 = harness.addBlockTest(block1, indices);

        // Calculate nullifier position using first loader's index
        uint256 nullifierPos = harness.getNullifierMemoryAddress(boundedTxNr, boundedDeposits, boundedWhich1);
        uint256 blobIndex = nullifierPos / 4096;
        uint256 posInBlob = nullifierPos % 4096;

        bytes32 nullifier = harness.access(blobhashes[blobIndex], posInBlob);

        if (boundedWhich1 != boundedWhich2) {
            uint256 absoluteAddress = harness.getNullifierMemoryAddress(boundedTxNr, boundedDeposits, boundedWhich2);
            harness.setValueAt(block2.blobhashes[absoluteAddress / 4096], absoluteAddress % 4096, nullifier);
        }

        NullifierChallenge.NullifierLoader memory loader1 = NullifierChallenge.NullifierLoader({
            data: block1, txNr: boundedTxNr, whichNullifier: boundedWhich1, commitment: "", proof: ""
        });
        NullifierChallenge.NullifierLoader memory loader2 = NullifierChallenge.NullifierLoader({
            data: block2, txNr: boundedTxNr, whichNullifier: boundedWhich2, commitment: "", proof: ""
        });

        // Challenge should succeed - same nullifier in two blocks
        // Use rollbackTarget (the block immediately before block2) for correct rollback
        harness.challengeNullifier(nullifier, loader1, loader2, rollbackTarget);

        // Verify rollback occurred
        // After rollback: block1 (0) + intermediate blocks (1 to n) remain, block2 is removed
        // rollback(block2.blockNr) sets roots.length = block2.blockNr = 1 + boundedIntermediateBlocks
        assertEq(
            harness.getBlockCount(), 1 + boundedIntermediateBlocks, "Should have rolled back to correct block count"
        );
    }

    /// @notice Fuzz test that wrong nullifier values are rejected
    /// @param seed Random seed
    /// @param numTransactions Number of transactions
    /// @param whichNullifier1 Which nullifier (0 or 1) for first loader
    /// @param whichNullifier2 Which nullifier (0 or 1) for second loader
    /// @param fakeNullifierSeed Seed for generating fake nullifier
    function testFuzz_WrongNullifierRejected(
        uint256 seed,
        uint8 numTransactions,
        uint8 whichNullifier1,
        uint8 whichNullifier2,
        uint256 fakeNullifierSeed
    ) public {
        uint256 boundedTx = bound(numTransactions, 1, 100);
        uint256 boundedWhich1 = bound(whichNullifier1, 0, 1);
        uint256 boundedWhich2 = bound(whichNullifier2, 0, 1);

        bytes32 anchor = keccak256(abi.encodePacked("anchor", seed));

        Spine.BlockData memory block1 = Spine.BlockData({
            anchor: anchor,
            timestamp: block.timestamp,
            numTransactions: boundedTx,
            numDeposits: 0,
            blockNr: 0,
            blockIndex: Spine.TimestampAndIndex(0, 0),
            sequencer: address(this),
            blobhashes: new bytes32[](1)
        });

        (block1,) = harness.setupBlocks(block1, seed);
        bytes32[] memory blobhashes = block1.blobhashes;
        vm.blobhashes(blobhashes);

        uint256[] memory indices = new uint256[](1);
        indices[0] = 0;

        block1 = harness.addBlockTest(block1, indices);
        Spine.BlockData memory block2 = harness.addBlockTest(block1, indices);

        // Generate a fake nullifier that won't match actual data
        bytes32 fakeNullifier = keccak256(abi.encodePacked("fake", fakeNullifierSeed));

        NullifierChallenge.NullifierLoader memory loader1 = NullifierChallenge.NullifierLoader({
            data: block1, txNr: 0, whichNullifier: boundedWhich1, commitment: "", proof: ""
        });
        NullifierChallenge.NullifierLoader memory loader2 = NullifierChallenge.NullifierLoader({
            data: block2, txNr: 0, whichNullifier: boundedWhich2, commitment: "", proof: ""
        });

        // Should revert - fake nullifier doesn't match blob data at either position
        vm.expectRevert();
        harness.challengeNullifier(fakeNullifier, loader1, loader2, block1);
    }
}
