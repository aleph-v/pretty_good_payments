contract NullifierChallengeHarness is NullifierChallenge, FakeBlobs {
    function setupBlocks(BlockData memory data, uint256 seed) public returns (BlockData memory, bytes32[] memory ret) {
        uint256 depositSize = data.numDeposits % 3 == 0 ? (data.numDeposits / 3) * 4 : (data.numDeposits / 3 + 1) * 4;
        uint256 dataNeeded = depositSize + data.numTransactions * 15;
        bytes32[] memory randomData = new bytes32[](dataNeeded);
        for (uint256 i = 0; i < dataNeeded; i++) {
            randomData[i] = keccak256(abi.encodePacked(i, seed));
        }
        ret = store(randomData);
        data.blobhashes = ret;
        return (data, ret);
    }

    function addBlockTest(BlockData memory data, uint256[] memory indices) public returns (BlockData memory) {
        addBlock(data, indices);
        return (data);
    }

    function validateSingle(bytes32 rootHash, bytes calldata, uint256 index, bytes32 data, bytes calldata)
        internal
        view
        override
    {
        require(access(rootHash, index) == data);
    }

    // Expose sequencer status for testing
    function getSequencerStatus(address sequencer)
        public
        view
        returns (
            bool isActive,
            bool isPriority,
            uint8 priorityIndex,
            uint64 blocknumberChallenged,
            uint64 timestampChallenged,
            uint64 stakeAmount,
            address payable challenger
        )
    {
        SequencerStatus memory status = sequencers[sequencer];
        return (
            status.isActive,
            status.isPriority,
            status.priorityIndex,
            status.blocknumberChallenged,
            status.timestampChallenged,
            status.stakeAmount,
            status.challenger
        );
    }

    // Expose current block number
    function getBlockCount() public view returns (uint256) {
        return getCurrentBlocknumber();
    }

    // Helper to fund a sequencer - forwards the call with value
    receive() external payable {}

    function fundSequencer() public payable {
        // Directly update sequencer state since fund() requires msg.sender to be the sequencer
        sequencers[msg.sender].isActive = true;
        sequencers[msg.sender].stakeAmount += uint64(msg.value / (10 ** 14));
    }

    // Helper to compute nullifier memory address
    function getNullifierMemoryAddress(uint256 txNr, uint256 numDeposits, uint256 which) public pure returns (uint256) {
        return nullifierMemoryAddress(txNr, numDeposits, which);
    }

    // Helper to set a value at a logical index in blob storage
    // Handles bit reversal internally so caller uses logical indices
    function setValueAt(bytes32 blobHash, uint256 logicalIndex, bytes32 value) public {
        uint256 storageIndex = bitReverse(logicalIndex);
        storeAt(blobHash, storageIndex, value);
    }

}

contract NullifierChallengeTest is Test {
    NullifierChallengeHarness harness;

    function setUp() public {
        harness = new NullifierChallengeHarness();
    }

    // ==================== ORDERING VALIDATION TESTS ====================

    // Test that nullifier reuse within same block can be challenged
    // Note: txNr ordering within same block is not enforced because:
    // 1. Two challengers cannot submit in the same transaction
    // 2. Cannot challenge post rollback
    // So the "first/second" naming is just for the challenger's convenience
    function test_SameBlockNullifierReuse() public {
        bytes32 sharedNullifier = keccak256("shared_nullifier");
        bytes32 anchor = keccak256("anchor");
        bytes32[] memory blobhashes = new bytes32[](1);

        // Create a block with 2 transactions, both having the same nullifier
        Spine.BlockData memory block1 = Spine.BlockData({
            anchor: anchor,
            timestamp: block.timestamp,
            numTransactions: 2,
            numDeposits: 0,
            blockNr: 0,
            blockIndex: Spine.TimestampAndIndex(0, 0),
            sequencer: address(this),
            blobhashes: blobhashes
        });

        // Setup with shared nullifier at tx 0 and tx 1
        uint256 dataNeeded = 2 * 15; // 2 transactions, 15 fields each
        bytes32[] memory randomData = new bytes32[](dataNeeded);
        for (uint256 i = 0; i < dataNeeded; i++) {
            randomData[i] = keccak256(abi.encodePacked(i, uint256(123)));
        }
        // Set same nullifier at tx 0 position 9 and tx 1 position 24
        randomData[9] = sharedNullifier; // tx 0, nullifier 0
        randomData[24] = sharedNullifier; // tx 1, nullifier 0 (15 + 9)

        bytes32[] memory ret = harness.store(randomData);
        block1.blobhashes = ret;
        vm.blobhashes(ret);

        uint256[] memory indices = new uint256[](1);
        indices[0] = 0;
        block1 = harness.addBlockTest(block1, indices);

        // Challenge with loaders pointing to different txs in same block
        NullifierChallenge.NullifierLoader memory loader1 =
            NullifierChallenge.NullifierLoader({data: block1, txNr: 0, whichNullifier: 0, commitment: "", proof: ""});
        NullifierChallenge.NullifierLoader memory loader2 =
            NullifierChallenge.NullifierLoader({data: block1, txNr: 1, whichNullifier: 0, commitment: "", proof: ""});

        Spine.BlockData memory emptyBlock;
        // This should succeed - nullifier reuse in same block is a valid challenge
        harness.challengeNullifier(sharedNullifier, loader1, loader2, emptyBlock);
    }

    // ==================== ORDERING VALIDATION TESTS (continued) ====================

    // Test that challenges with blocks in wrong order are rejected
    // The "first" block must have blockNr <= "second" block
    function test_RejectFirstBlockAfterSecond() public {
        bytes32 anchor = keccak256("anchor");
        bytes32[] memory blobhashes = new bytes32[](1);

        Spine.BlockData memory block1 = Spine.BlockData({
            anchor: anchor,
            timestamp: block.timestamp,
            numTransactions: 1,
            numDeposits: 0,
            blockNr: 0,
            blockIndex: Spine.TimestampAndIndex(0, 0),
            sequencer: address(this),
            blobhashes: blobhashes
        });

        (block1, blobhashes) = harness.setupBlocks(block1, 0);
        vm.blobhashes(blobhashes);

        uint256[] memory indices = new uint256[](1);
        indices[0] = 0;

        // Add two blocks with same data
        block1 = harness.addBlockTest(block1, indices);
        Spine.BlockData memory block2 = harness.addBlockTest(block1, indices);

        bytes32 nullifier = harness.access(blobhashes[0], 9);

        // Create loaders with WRONG ORDER - first has higher blockNr than second
        NullifierChallenge.NullifierLoader memory loader1 = NullifierChallenge.NullifierLoader({
            data: block2, // blockNr = 1 (higher)
            txNr: 0,
            whichNullifier: 0,
            commitment: "",
            proof: ""
        });
        NullifierChallenge.NullifierLoader memory loader2 = NullifierChallenge.NullifierLoader({
            data: block1, // blockNr = 0 (lower)
            txNr: 0,
            whichNullifier: 0,
            commitment: "",
            proof: ""
        });

        Spine.BlockData memory emptyBlock;

        // Should revert - first.blockNr (1) > second.blockNr (0)
        vm.expectRevert();
        harness.challengeNullifier(nullifier, loader1, loader2, emptyBlock);
    }

    // ==================== BOUNDARY TESTS ====================

    // Test that txNr out of bounds is properly rejected
    // txNr is 0-indexed, so with numTransactions=1, only txNr=0 is valid
    function test_TxNrOutOfBoundsRejected() public {
        bytes32 anchor = keccak256("anchor");
        bytes32[] memory blobhashes = new bytes32[](1);

        Spine.BlockData memory block1 = Spine.BlockData({
            anchor: anchor,
            timestamp: block.timestamp,
            numTransactions: 1, // Only 1 tx, valid indices are [0]
            numDeposits: 0,
            blockNr: 0,
            blockIndex: Spine.TimestampAndIndex(0, 0),
            sequencer: address(this),
            blobhashes: blobhashes
        });

        (block1, blobhashes) = harness.setupBlocks(block1, 0);
        vm.blobhashes(blobhashes);

        uint256[] memory indices = new uint256[](1);
        indices[0] = 0;
        block1 = harness.addBlockTest(block1, indices);
        Spine.BlockData memory block2 = harness.addBlockTest(block1, indices);

        // Create loader with txNr = 1, but numTransactions = 1
        // Valid txNr should be 0 only (0-indexed), so txNr=1 is out of bounds
        NullifierChallenge.NullifierLoader memory loader1 = NullifierChallenge.NullifierLoader({
            data: block1,
            txNr: 1, // OUT OF BOUNDS - should be rejected
            whichNullifier: 0,
            commitment: "",
            proof: ""
        });
        NullifierChallenge.NullifierLoader memory loader2 = NullifierChallenge.NullifierLoader({
            data: block2,
            txNr: 1, // OUT OF BOUNDS - should be rejected
            whichNullifier: 0,
            commitment: "",
            proof: ""
        });

        // Accessing nullifier at position beyond transaction data
        bytes32 outOfBoundsData = harness.access(blobhashes[0], 24); // 15 + 9

        // Should revert due to bounds checking
        vm.expectRevert();
        harness.challengeNullifier(outOfBoundsData, loader1, loader2, block1);
    }

    // ==================== SLASHING MECHANISM TESTS ====================

    // Test that slashing correctly sets the challenger address
    // (Previously bugged: used == instead of = for assignments)
    function test_SlashingSetsChallenger() public {
        address sequencer = address(0x1234);
        address challenger = address(this);

        // Fund the sequencer so they have stake
        vm.deal(sequencer, 100 ether);
        vm.prank(sequencer);
        harness.fundSequencer{value: 20 ether}();

        // Verify sequencer is active
        (bool isActive,,,,,, address payable currentChallenger) = harness.getSequencerStatus(sequencer);
        assertTrue(isActive, "Sequencer should be active");
        assertEq(currentChallenger, address(0), "No challenger initially");

        bytes32 anchor = keccak256("anchor");
        bytes32[] memory blobhashes = new bytes32[](1);

        Spine.BlockData memory block1 = Spine.BlockData({
            anchor: anchor,
            timestamp: block.timestamp,
            numTransactions: 1,
            numDeposits: 0,
            blockNr: 0,
            blockIndex: Spine.TimestampAndIndex(0, 0),
            sequencer: sequencer, // Assign to funded sequencer
            blobhashes: blobhashes
        });

        (block1, blobhashes) = harness.setupBlocks(block1, 0);
        vm.blobhashes(blobhashes);

        uint256[] memory indices = new uint256[](1);
        indices[0] = 0;
        block1 = harness.addBlockTest(block1, indices);
        Spine.BlockData memory block2 = harness.addBlockTest(block1, indices);

        bytes32 nullifier = harness.access(blobhashes[0], 9);

        NullifierChallenge.NullifierLoader memory loader1 =
            NullifierChallenge.NullifierLoader({data: block1, txNr: 0, whichNullifier: 0, commitment: "", proof: ""});
        NullifierChallenge.NullifierLoader memory loader2 =
            NullifierChallenge.NullifierLoader({data: block2, txNr: 0, whichNullifier: 0, commitment: "", proof: ""});

        // Challenge as the challenger address
        vm.prank(challenger);
        harness.challengeNullifier(nullifier, loader1, loader2, block1);

        // Verify sequencer was deactivated
        (isActive,,,,,, currentChallenger) = harness.getSequencerStatus(sequencer);
        assertFalse(isActive, "Sequencer should be slashed/inactive");

        // The challenger should be set to msg.sender
        assertEq(currentChallenger, challenger, "Challenger should be set to msg.sender");
    }

