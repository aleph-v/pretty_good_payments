pragma solidity ^0.8.28;

// Note- Test code in this file was generated by claude code and human reviewed

import {Test} from "forge-std/Test.sol";
import {Spine} from "../src/Spine.sol";
import {
    ZeroBlobHash,
    TooManyDeposits,
    TooManyLeaves,
    InsufficientBlobCapacity,
    RollbackIndexOutOfBounds,
    PriorRootMismatch,
    AnchorNotIncluded,
    AnchorIndexMismatch
} from "../src/library/Errors.sol";

// Test contract that inherits from Spine to expose internal functions
contract SpineHarness is Spine {
    // Expose internal functions for testing

    constructor(bytes32 genesis) {
        GENESIS_ANCHOR = genesis;
    }

    function addBlockTest(BlockData memory data, uint256[] memory blobIndices) external {
        addBlock(data, blobIndices);
    }

    function rollbackTest(uint256 index, BlockData memory priorBlock) external {
        rollback(index, priorBlock);
    }

    function isBlockIncludedTest(BlockData memory data) external view returns (bool) {
        return isBlockIncluded(data);
    }

    function getRootsLength() external view returns (uint256) {
        return getCurrentBlocknumber();
    }

    function getStart() external view returns (uint256) {
        return START;
    }

    function getChallengePeriod() external pure returns (uint256) {
        return CHALLENGE_PERIOD;
    }

    function getMaxLeaves() external pure returns (uint256) {
        return MAX_LEAVES;
    }

    function getMaxDeposits() external pure returns (uint256) {
        return MAX_DEPOSITS;
    }

    function getDay() external pure returns (uint256) {
        return DAY;
    }

    // Push a root directly for testing (bypasses validation)
    function pushRootForTest(bytes32 root) external {
        // Using assembly to push to the roots array
        assembly ("memory-safe") {
            // Load the current length of roots
            let len := sload(roots.slot)
            // Calculate storage slot for new element
            mstore(0, roots.slot)
            let slot := add(keccak256(0, 32), len)
            // Store the new root
            sstore(slot, root)
            // Increment the length
            sstore(roots.slot, add(len, 1))
        }
    }

    // Set anchor index for testing
    function setAnchorIndexForTest(bytes32 anchor, uint64 index, bytes24 partialHash) external {
        anchorToIndex[anchor].index = index;
        anchorToIndex[anchor].partialHash = partialHash;
    }

    // Get the last timestamp for testing
    function getLastTimestamp() external view returns (TimestampAndIndex memory) {
        return lastTimestamp;
    }

    // Get anchor info for testing
    function getAnchorInfo(bytes32 anchor) external view returns (uint64 index, bytes24 partialHash) {
        return (anchorToIndex[anchor].index, anchorToIndex[anchor].partialHash);
    }

    // Get root at index for testing
    function getRootAt(uint256 index) external view returns (bytes32) {
        return roots[index];
    }

    // Expose validatePriorAnchor for testing
    function validatePriorAnchorTest(
        bytes32 anchor,
        BlockData memory data,
        uint256 updateNr,
        bool isDeposit,
        bytes calldata commitment,
        bytes calldata proof
    ) external view {
        validatePriorAnchor(anchor, data, updateNr, isDeposit, commitment, proof);
    }
}

contract SpineTest is Test {
    SpineHarness spine;

    function setUp() public {
        spine = new SpineHarness(keccak256("0x0"));
    }

    // Helper to create a basic BlockData struct
    function createBlockData(bytes32 anchor, uint256 numTx, uint256 numDeposits)
        internal
        view
        returns (Spine.BlockData memory)
    {
        bytes32[] memory blobhashes = new bytes32[](1);
        return Spine.BlockData({
            anchor: anchor,
            timestamp: block.timestamp,
            numTransactions: numTx,
            numDeposits: numDeposits,
            blockNr: 0,
            blockIndex: Spine.TimestampAndIndex(0, 0),
            sequencer: address(this),
            blobhashes: blobhashes
        });
    }

    // ============ Constants Tests ============

    function test_Constants() public view {
        // CHALLENGE_PERIOD is configurable, just verify it's reasonable (> 0)
        assertGt(spine.getChallengePeriod(), 0, "CHALLENGE_PERIOD should be > 0");
        assertEq(spine.getMaxLeaves(), 65536, "MAX_LEAVES should be 65536");
        assertEq(spine.getMaxDeposits(), 3072, "MAX_DEPOSITS should be 3072");
        assertEq(spine.getDay(), 86400, "DAY should be 86400 seconds");

        uint256 start = spine.getStart();
        assertGt(start, 0, "START should be > 0");
        assertLe(start, block.timestamp, "START should be <= current timestamp");
    }

    // ============ getCurrentBlocknumber Tests ============

    function test_GetCurrentBlocknumber_InitiallyZero() public view {
        assertEq(spine.getCurrentBlocknumber(), 0);
    }

    function test_GetCurrentBlocknumber_AfterPushingRoots() public {
        spine.pushRootForTest(keccak256("root1"));
        assertEq(spine.getCurrentBlocknumber(), 1);

        spine.pushRootForTest(keccak256("root2"));
        assertEq(spine.getCurrentBlocknumber(), 2);

        spine.pushRootForTest(keccak256("root3"));
        assertEq(spine.getCurrentBlocknumber(), 3);
    }

    // ============ isAnchorIncluded Tests ============

    function test_IsAnchorIncluded_ReturnsFalseForNonExistent() public view {
        bytes32 randomAnchor = keccak256("random anchor");
        assertFalse(spine.isAnchorIncluded(randomAnchor));
    }

    function test_IsAnchorIncluded_ReturnsFalseWhenIndexOutOfBounds() public {
        bytes32 anchor = keccak256("test");
        // Set an index that's out of bounds (no roots added yet)
        spine.setAnchorIndexForTest(anchor, 5, bytes24(keccak256("hash")));
        assertFalse(spine.isAnchorIncluded(anchor));
    }

    function test_IsAnchorIncluded_ReturnsTrueWhenValid() public {
        bytes32 root = keccak256("root1");
        bytes32 anchor = keccak256("anchor1");

        // Push a root
        spine.pushRootForTest(root);

        // Set anchor with matching partial hash
        spine.setAnchorIndexForTest(anchor, 0, bytes24(root));

        assertTrue(spine.isAnchorIncluded(anchor));
    }

    function test_IsAnchorIncluded_ReturnsFalseWhenPartialHashMismatch() public {
        bytes32 root = keccak256("root1");
        bytes32 anchor = keccak256("anchor1");

        // Push a root
        spine.pushRootForTest(root);

        // Set anchor with NON-matching partial hash
        spine.setAnchorIndexForTest(anchor, 0, bytes24(keccak256("different")));

        assertFalse(spine.isAnchorIncluded(anchor));
    }

    // ============ isConfirmed Tests ============

    function test_IsConfirmed_RevertsForNonExistentBlockNr() public {
        Spine.BlockData memory data = createBlockData(keccak256("anchor"), 10, 5);
        // When roots array is empty and blockNr=0, accessing roots[0] reverts
        vm.expectRevert();
        spine.isConfirmed(data);
    }

    function test_IsConfirmed_ReturnsFalseBeforeChallengePeriod() public {
        // Create block data
        bytes32 anchor = keccak256("anchor");
        Spine.BlockData memory data = createBlockData(anchor, 10, 5);
        data.timestamp = block.timestamp;

        // Compute and push the block hash
        bytes32 blockHash = keccak256(abi.encode(data));
        spine.pushRootForTest(blockHash);

        // Block is included but challenge period hasn't passed
        assertTrue(spine.isBlockIncludedTest(data));
        assertFalse(spine.isConfirmed(data));
    }

    function test_IsConfirmed_ReturnsTrueAfterChallengePeriod() public {
        // Create block data
        bytes32 anchor = keccak256("anchor");
        Spine.BlockData memory data = createBlockData(anchor, 10, 5);
        data.timestamp = block.timestamp;

        // Compute and push the block hash
        bytes32 blockHash = keccak256(abi.encode(data));
        spine.pushRootForTest(blockHash);

        // Warp time past challenge period (load actual value from contract)
        uint256 challengePeriod = spine.getChallengePeriod();
        vm.warp(block.timestamp + challengePeriod + 1);

        assertTrue(spine.isConfirmed(data));
    }

    // ============ isBlockIncluded Tests ============

    function test_IsBlockIncluded_RevertsForNonExistentBlockNr() public {
        Spine.BlockData memory data = createBlockData(keccak256("anchor"), 10, 5);
        // When roots array is empty and blockNr=0, accessing roots[0] reverts
        vm.expectRevert();
        spine.isBlockIncludedTest(data);
    }

    function test_IsBlockIncluded_ReturnsTrueWhenHashMatches() public {
