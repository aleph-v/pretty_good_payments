        spine.pushRootForTest(blockHash);

        assertTrue(spine.isBlockIncludedTest(data));
    }

    function test_IsBlockIncluded_ReturnsFalseWhenHashMismatch() public {
        Spine.BlockData memory data = createBlockData(keccak256("anchor"), 10, 5);

        // Push a different hash
        spine.pushRootForTest(keccak256("different"));

        assertFalse(spine.isBlockIncludedTest(data));
    }

    // ============ TimestampAndIndex Tests ============

    function test_TimestampAndIndex_Struct() public pure {
