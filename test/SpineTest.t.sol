    }

    // ============ Anchor Lookup Tests ============

    function test_AnchorLookup_MultipleAnchors() public {
        bytes32 root1 = keccak256("root1");
        bytes32 root2 = keccak256("root2");
        bytes32 anchor1 = keccak256("anchor1");
        bytes32 anchor2 = keccak256("anchor2");

        spine.pushRootForTest(root1);
        spine.pushRootForTest(root2);

        spine.setAnchorIndexForTest(anchor1, 0, bytes24(root1));
        spine.setAnchorIndexForTest(anchor2, 1, bytes24(root2));

