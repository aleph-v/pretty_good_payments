    // ============ Day Boundary Condition Tests ============

    function test_DayBoundary_ExactlyAtDayBoundary() public {
        setupBlobHashes(1);
        uint256[] memory blobIndices = new uint256[](1);
        blobIndices[0] = 0;

        uint256 start = spine.getStart();
        uint256 day = spine.getDay();

        // Add a block on day 0
        Spine.BlockData memory data1 = createBlockDataForAdd(keccak256("anchor1"), 10, 5, 1);
        spine.addBlockTest(data1, blobIndices);

        Spine.TimestampAndIndex memory ts1 = spine.getLastTimestamp();
        assertEq(ts1.day, 0);
        assertEq(ts1.index, 0);

        // Warp to exactly the start of day 1 (START + DAY)
        vm.warp(start + day);

        // Add a block exactly at day boundary
        Spine.BlockData memory data2 = createBlockDataForAdd(keccak256("anchor2"), 10, 5, 1);
        spine.addBlockTest(data2, blobIndices);

        Spine.TimestampAndIndex memory ts2 = spine.getLastTimestamp();
        assertEq(ts2.day, 1, "Should be day 1 exactly at boundary");
        assertEq(ts2.index, 0, "Index should reset to 0 on new day");
    }

