        bytes32 anchor1 = keccak256("anchor1");
        bytes32 anchor2 = keccak256("anchor2");
        bytes32 anchor3 = keccak256("anchor3");
        bytes32[] memory blobhashes1 = new bytes32[](1);
        blobhashes1[0] = 0x9feb17818ead28ad21b36982a855cbda1507afb6845b9c22fab64981f9bb5c8a;

        Spine.BlockData memory block1 = Spine.BlockData({
            anchor: anchor1,
            timestamp: block.timestamp,
            numTransactions: 10,
            numDeposits: 5,
            blockNr: 0,
            blockIndex: Spine.TimestampAndIndex(0, 0), // Specific day and index
            sequencer: address(this),
            blobhashes: blobhashes1
        });

        Spine.BlockData memory block2 = Spine.BlockData({
            anchor: anchor2,
            timestamp: block.timestamp,
            numTransactions: 11,
            numDeposits: 6,
            blockNr: 1,
            blockIndex: Spine.TimestampAndIndex(0, 1), // Specific day and index
            sequencer: address(this),
            blobhashes: blobhashes1
        });

        uint256[] memory blobIndices = new uint256[](1);
        blobIndices[0] = 0;

        spine.addBlockTest(block1, blobIndices);
        spine.addBlockTest(block2, blobIndices);

        spine.rollbackTest(1, block1);
