    function test_Rollback_MultipleRollbacks() public {
        // Create blocks with known hashes
        bytes32[] memory blobhashes = new bytes32[](1);
        blobhashes[0] = keccak256("blob");

        Spine.BlockData memory block0 = Spine.BlockData({
